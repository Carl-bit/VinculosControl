# Dependencias y builds
node_modules/
dist/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Secretos: token del agente, contrasenas de la BD control, secretos de la
# consola y del sitio. Nunca se suben: solo los .env.example.
.env
.env.*
!.env.example

# Red de seguridad: material que nunca debe salir del host (llaves, tokens
# internos de los silos, certificados, respaldos). Este repo no los genera,
# pero el operador trabaja al lado del repo del ERP.
*.token
infra/host-b/internos/
infra/host-b/bajas/
*.pem
*.key
*.p12
*.pfx
*.shamir
kek
kek.*
*.dump
*.backup
*.sql.gz

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Configuracion personal de herramientas y editores
.claude/settings.local.json
.vscode/*
!.vscode/tasks.json
.idea/

# Sistema operativo
.DS_Store
Thumbs.db
infra/host-b/silos/
infra/host-b/imagenes/

# Capturas de pantalla (anexo de tesis) y artefactos de Playwright: se generan
# en local contra el entorno de pruebas y no se versionan.
capturas-control/
capturas*/
test-results/
playwright-report/
blob-report/
playwright/.cache/
