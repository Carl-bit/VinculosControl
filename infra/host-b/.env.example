# URL de la API del plano de control (host A). En pruebas, la IP del PC en la red local.
CONTROL_URL=http://192.168.1.50:4000
# Token del agente: pnpm api agente:crear host-b (en el host A). Se muestra una sola vez.
AGENTE_TOKEN=
# Carpeta de respaldos del repo del ERP en este host (respaldar.sh escribe ahi).
RESPALDOS_HOST=/home/dev/Vinculos/Vinculos/infra/respaldos
# Token entre el agente y el ejecutor de silos (32+ caracteres). Generar en este host: openssl rand -hex 32
EJECUTOR_TOKEN=
# Carpeta con un <slug>.token por silo (token de /api/internal/*). En pruebas,
# infra/servidor/internos del repo del ERP (la llena servidor.sh). Permisos 700.
# Vacio: infra/host-b/internos/ de este repo (ignorada por git).
TOKENS_INTERNOS_HOST=/home/dev/Vinculos/Vinculos/infra/servidor/internos
# Contenedores que el ejecutor une a cada red de borde (Traefik del host y este agente).
EJECUTOR_UNIR_BORDE=vinculos-servidor-traefik-1,vinculos-agente-agente-1
# Solo desarrollo local (docs/entorno-local.md): API del ERP corriendo fuera de Docker.
# SILO_INTERNO_URL=http://host.docker.internal:3001/api/internal

# Consentimiento local para eliminar silos (opcion C): carpeta con un archivo por slug
# (bajas/<slug>) que contiene el hash del acta de recepcion. Ignorada por git.
BAJAS_HOST=./bajas

# Registro privado de imagenes (R1): puerto en 127.0.0.1 del host B. publicar.sh del ERP
# usa REGISTRO=127.0.0.1:<puerto> (por defecto 5000).
# REGISTRO_PUERTO=5000
