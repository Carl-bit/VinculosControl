# BD control (solo metadatos; nunca datos clinicos).
DATABASE_URL=postgresql://control:cambiar@127.0.0.1:5440/control
# Secreto compartido con apps/web: las rutas /consola solo responden a la web.
CONSOLA_SECRETO=cambiar-por-un-valor-largo
PORT=4000
# Sondeo de /api/salud de cada silo adoptado (segundos).
SALUD_INTERVALO_S=60
# Correo del login de la consola (codigo de 6 digitos). Local: Mailpit de infra/host-a (UI en http://127.0.0.1:8026).
# Produccion: interfaz SMTP de SES (puerto 587 + SMTP_USUARIO/SMTP_CLAVE) y su configuration set propio.
SMTP_HOST=127.0.0.1
SMTP_PUERTO=1026
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=vinculos-control <consola@vinculos.local>
SES_CONFIGURATION_SET=
# Secreto compartido con apps/sitio (formulario publico). Distinto de CONSOLA_SECRETO.
SITIO_SECRETO=otro-valor-largo-distinto
# Direccion publica del sitio (arma el enlace de fase 2) y dominio base de los subdominios de los silos.
SITIO_URL=http://127.0.0.1:3200
DOMINIO_BASE=vinculos.cl
